{
  "id": "lastminute-flug",
  "name": "lastminute.de Flug",
  "manifest_id": "flight",
  "kind": "browser",
  "icon": "plane",
  "description": "Günstigster Flugpreis pro Person über lastminute.de, inkl. Reisedauer der günstigsten Verbindung.",
  "note": "Datum steht als YYYYMMDD in der URL (outbound_compact/inbound_compact). Gelesen wird der Reiter „Günstigster\" — die Angebotsliste selbst ist NICHT nach Preis sortiert, ein Minimum über die sichtbaren Karten läge daneben.",
  "site": "https://www.lastminute.de/",
  "goal_template": "Günstigsten Flugpreis für {{origin}} → {{dest}} ({{outbound}}{% if inbound %} / {{inbound}}{% endif %}) bei lastminute.de auslesen.",
  "default_schedule": "0 7 * * *",
  "params": {
    "_category": "price"
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "price": {
        "type": "number"
      },
      "duration": {
        "type": "string"
      }
    },
    "required": [
      "price"
    ]
  },
  "recipe": [
    {
      "action": "goto",
      "url": "https://www.lastminute.de/s/flights/search/v2/results?itinerary.path[0].departure={{origin_code}}&itinerary.path[0].arrival={{dest_code}}&itinerary.path[0].date={{outbound_compact}}&itinerary.path[1].departure={{dest_code}}&itinerary.path[1].arrival={{origin_code}}&itinerary.path[1].date={{inbound_compact}}&itinerary.type=ROUND_TRIP&passengers.adults={{adults}}&passengers.children={{children}}"
    },
    {
      "action": "consent",
      "optional": true
    },
    {
      "action": "waitFor",
      "selector": "button:has-text(\"Günstigster\")",
      "ms": 120000
    },
    {
      "action": "wait",
      "ms": 5000
    },
    {
      "action": "extract",
      "mode": "dom_map",
      "fallback": "ai_json",
      "map": {
        "price": {
          "selector": "button:has-text(\"Günstigster\")",
          "as": "number",
          "regex": "([\\d.]+,\\d{2})\\s*€"
        },
        "duration": {
          "selector": "button:has-text(\"Günstigster\")",
          "regex": "(\\d+\\s?Std\\.\\s*\\d*)"
        }
      }
    }
  ],
  "version": 1
}