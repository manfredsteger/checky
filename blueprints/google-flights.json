{
  "id": "google-flights",
  "name": "Google Flights",
  "manifest_id": "flight",
  "kind": "browser",
  "icon": "plane",
  "description": "Günstigster Flugpreis über Google Flights. Suche per URL-Abfrage — kein Anlernen nötig.",
  "note": "Google mischt Uhrzeiten und Preise im selben Element; der Preis wird per Regex herausgefiltert. Stopp-/Dauerfilter werden hier NICHT angewandt.",
  "site": "https://www.google.com/travel/flights",
  "goal_template": "Günstigsten Flugpreis für {{origin}} → {{dest}} ({{outbound}}{% if inbound %} / {{inbound}}{% endif %}) bei Google Flights auslesen.",
  "default_schedule": "0 7 * * *",
  "params": {
    "_category": "price"
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "price": {
        "type": "number"
      }
    },
    "required": [
      "price"
    ]
  },
  "recipe": [
    {
      "action": "goto",
      "url": "https://www.google.com/travel/flights?q=Flights%20to%20{{dest_code}}%20from%20{{origin_code}}%20on%20{{outbound}}%20through%20{{inbound}}&curr=EUR&hl=de"
    },
    {
      "action": "consent",
      "optional": true
    },
    {
      "action": "wait",
      "ms": 10000,
      "note": "Google rendert die Liste clientseitig"
    },
    {
      "action": "extract",
      "mode": "dom_map",
      "fallback": "ai_json",
      "map": {
        "price": {
          "selector": ".YMlIz",
          "reduce": "min_number",
          "regex": "(\\d{1,3}(?:\\.\\d{3})*)\\s*€"
        }
      }
    }
  ],
  "version": 1
}