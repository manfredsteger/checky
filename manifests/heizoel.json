{
  "id": "heizoel",
  "name": "Heizölpreis",
  "icon": "oil",
  "description": "Heizölpreis für eine Region und Bestellmenge beobachten.",
  "params": [
    { "key": "plz", "label": "PLZ", "type": "text", "default": "", "placeholder": "z.B. 85221", "help": "Postleitzahl für die Lieferregion" },
