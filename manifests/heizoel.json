  "result_schema": {
    "type": "object",
    "properties": {
      "price_per_100l": { "type": "string" },
      "total": { "type": "string" },
      "supplier": { "type": "string" }
    }
  },
  "display": { "headline": "price_per_100l", "chart_field": "price_per_100l", "target_param": "target_price", "unit": "€/100L" },
  "goal_template": "Heizölpreis für PLZ {{plz}}, Menge {{menge}} Liter. Preis pro 100 Liter + Gesamtpreis + Anbieter auslesen.",
