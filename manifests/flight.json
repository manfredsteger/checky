{
  "id": "flight",
  "name": "Flugpreis",
  "icon": "plane",
  "description": "Flugpreise und Verfügbarkeit für eine Route beobachten.",
  "params": [
    {
      "key": "origin",
      "label": "Abflughafen",
      "type": "text",
      "default": "",
      "placeholder": "z.B. MUC oder München",
      "help": "IATA-Code oder Stadt"
    },
    {
      "key": "dest",
      "label": "Zielflughafen",
      "type": "text",
      "default": "",
      "placeholder": "z.B. HND oder Tokio"
    },
    {
      "key": "dest_code",
      "label": "Ziel-Code (IATA)",
      "type": "text",
      "default": "",
      "placeholder": "z.B. TYO",
      "help": "Stadtcode erlaubt (TYO = alle Tokioter Flughäfen). Leer = Zielflughafen wird verwendet."
    },
    {
      "key": "origin_code",
      "label": "Abflug-Code (IATA)",
      "type": "text",
      "default": "",
      "placeholder": "z.B. MUC",
      "help": "Nur für URL-basierte Quellen (Kayak/Momondo/SWOODOO/Google). Leer = Abflughafen wird verwendet, sofern er schon ein 3-Buchstaben-Code ist."
    },
    {
      "key": "outbound",
      "label": "Hinreise",
      "type": "date",
      "default": ""
    },
    {
      "key": "inbound",
      "label": "Rückreise",
      "type": "date",
      "default": "",
      "help": "leer lassen für Nur-Hinflug"
    },
    {
      "key": "adults",
      "label": "Erwachsene",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 9
    },
    {
      "key": "children",
      "label": "Kinder",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 9
    },
    {
      "key": "cabin",
      "label": "Klasse",
      "type": "select",
      "options": [
        "economy",
        "premium",
        "business",
        "first"
      ],
      "default": "economy"
    },
    {
      "key": "max_stops",
      "label": "Max. Zwischenstopps",
      "type": "select",
      "options": [
        "0",
        "1",
        "2"
      ],
      "default": "1",
      "help": "1 = max. ein Umstieg (realistisch). 0 = nur Direkt — bei fernen Daten oft überteuerte Phantomtarife. Mit max_duration_h absichern"
    },
    {
      "key": "max_duration_h",
      "label": "Max. Reisezeit je Strecke (h)",
      "type": "number",
      "default": null,
      "help": "Optional: Flüge länger als das werden verworfen"
    },
    {
      "key": "target_price",
      "label": "Wunschpreis (€)",
      "type": "number",
      "default": null,
      "help": "Bei diesem Preis oder darunter hervorheben/benachrichtigen"
    },
    {
      "key": "max_price",
      "label": "Schmerzgrenze (€)",
      "type": "number",
      "default": null,
      "help": "Oberhalb als teuer markieren"
    },
    {
      "key": "dest_out_code",
      "label": "Ziel Hinflug (IATA)",
      "type": "text",
      "default": "",
      "placeholder": "z.B. KIX",
      "help": "Nur für Gabelflüge: Ankunft des Hinflugs, wenn sie vom Rückflug-Abflug abweicht. Leer = normaler Hin-/Rückflug."
    },
    {
      "key": "origin_in_code",
      "label": "Abflug Rückflug (IATA)",
      "type": "text",
      "default": "",
      "placeholder": "z.B. TYO",
      "help": "Nur für Gabelflüge: von wo der Rückflug startet. Leer = wie Ziel Hinflug."
    }
  ],
  "result_schema": {
    "type": "object",
    "properties": {
      "price": {
        "type": "string"
      },
      "currency": {
        "type": "string"
      },
      "airline": {
        "type": "string"
      },
      "stops": {
        "type": "string"
      },
      "duration": {
        "type": "string"
      }
    }
  },
  "display": {
    "headline": "price",
    "chart_field": "price",
    "target_param": "target_price",
    "max_param": "max_price",
    "unit": "€",
    "trend_good": "down",
    "secondary": [
      {
        "field": "airline"
      },
      {
        "field": "stops"
      },
      {
        "field": "duration_out_h",
        "label": "Hin",
        "suffix": " h"
      },
      {
        "field": "duration_in_h",
        "label": "Rück",
        "suffix": " h"
      }
    ]
  },
  "goal_template": "Flug {{origin}} → {{dest}} ({{outbound}}{% if inbound %} / {{inbound}}{% endif %}), {{adults}} Erwachsene + {{children}} Kinder, {{cabin}}. Günstigsten Gesamtpreis + Airline auslesen.",
  "default_schedule": "0 7 * * *",
  "version": 3,
  "changelog": [
    "v1: Erststand — origin/dest/dates/pax/cabin/target_price/max_price",
    "v2: origin_code/dest_code für URL-basierte Quellen (Deep-Link-Blueprints)",
    "v3: dest_out_code/origin_in_code für Gabelflüge (open jaw)"
  ]
}