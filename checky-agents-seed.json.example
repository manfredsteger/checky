{
  "project": {
    "name": "Flugsuche Beispielreise",
    "description": "Beispiel für ein Flugsuche-Projekt mit mehreren Quellen — Kopie nach checky-agents-seed.json anlegen und Route/Daten/Personenzahl anpassen (die Kopie ist gitignored, landet nie im Repo)."
  },
  "defaults": {
    "params": {
      "origin": "XXX",
      "dest_tokyo": "YYY",
      "dest_osaka": "ZZZ",
      "outbound": "2027-01-01",
      "inbound": "2027-01-15",
      "adults": "2",
      "children": "0",
      "cabin": "economy"
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "price": { "type": "string" },
        "currency": { "type": "string" },
        "airline": { "type": "string" },
        "stops": { "type": "string" },
        "duration": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  },
  "agents": [
    {
      "name": "Beispiel-Quelle",
      "site": "https://www.example.com",
      "goal_text": "Round-trip {{origin}}→{{dest_tokyo}}, Hin {{outbound}} / Rück {{inbound}}, {{adults}} Erwachsene + {{children}} Kinder, Klasse {{cabin}}. Günstigsten Preis auslesen.",
      "schedule_cron": "0 7 * * *",
      "priority": 1,
      "note": "Ein Agent pro Quelle — für weitere Quellen einfach weitere Einträge in dieses Array anhängen."
    }
  ]
}
